<Window x:Class="UsageWidget.App.UI.TemplateEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Endpoint setup (Request Template)" Width="640" Height="720"
        WindowStartupLocation="CenterScreen" Background="#1E1E1E">
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" Text="Endpoint setup" Foreground="White"
                   FontSize="18" FontWeight="SemiBold" />
        <TextBlock DockPanel.Dock="Top" Foreground="#AAAAAA" FontSize="12" Margin="0,4,0,10"
                   TextWrapping="Wrap"
                   Text="Tell the app exactly which request to replay for each service. Capture it once: F12 → Network → refresh the Usage page → click the request whose Response JSON shows your usage. Copy the Request URL into 'URL', and the field locations into the mapping boxes (e.g. $.five_hour.utilization). Put {{TOKEN}} where your secret goes in the headers — the real token stays in Windows Credential Manager." />

        <DockPanel DockPanel.Dock="Bottom" LastChildFill="False" Margin="0,10,0,0">
            <TextBlock x:Name="ValidationText" Foreground="#E08A8A" VerticalAlignment="Center"
                       TextWrapping="Wrap" Width="380" />
            <Button Content="Cancel" Width="90" Padding="6,4" DockPanel.Dock="Right" Click="OnCancel" />
            <Button Content="Save" Width="90" Padding="6,4" DockPanel.Dock="Right" Margin="0,0,8,0"
                    Click="OnSave" IsDefault="True" />
        </DockPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Service" Foreground="#BBBBBB" Margin="0,6,0,2" />
                <ComboBox x:Name="SourceCombo" DisplayMemberPath="Display"
                          SelectionChanged="OnSourceChanged" />

                <TextBlock Text="URL" Foreground="#BBBBBB" Margin="0,10,0,2" />
                <TextBox x:Name="UrlBox" Padding="4" FontFamily="Consolas" TextWrapping="Wrap" />

                <TextBlock Text="HTTP method" Foreground="#BBBBBB" Margin="0,10,0,2" />
                <TextBox x:Name="MethodBox" Padding="4" Width="120" HorizontalAlignment="Left" />

                <TextBlock Text="Allowed hosts (comma-separated)" Foreground="#BBBBBB" Margin="0,10,0,2" />
                <TextBox x:Name="HostsBox" Padding="4" FontFamily="Consolas" />

                <TextBlock Text="Headers (one per line, e.g.  Authorization: Bearer {{TOKEN}})"
                           Foreground="#BBBBBB" Margin="0,10,0,2" />
                <TextBox x:Name="HeadersBox" Height="110" Padding="4" FontFamily="Consolas"
                         AcceptsReturn="True" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />

                <Separator Margin="0,12" />
                <TextBlock Text="Where to read the numbers (JSONPath, or header:Name)"
                           Foreground="White" FontWeight="SemiBold" Margin="0,0,0,6" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0">
                        <TextBlock Text="Session % used" Foreground="#BBBBBB" Margin="0,4,0,2" />
                        <TextBox x:Name="SessionPctBox" Padding="4" FontFamily="Consolas" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="2">
                        <TextBlock Text="Weekly % used" Foreground="#BBBBBB" Margin="0,4,0,2" />
                        <TextBox x:Name="WeeklyPctBox" Padding="4" FontFamily="Consolas" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0">
                        <TextBlock Text="Session reset" Foreground="#BBBBBB" Margin="0,8,0,2" />
                        <TextBox x:Name="SessionResetBox" Padding="4" FontFamily="Consolas" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="2">
                        <TextBlock Text="Weekly reset" Foreground="#BBBBBB" Margin="0,8,0,2" />
                        <TextBox x:Name="WeeklyResetBox" Padding="4" FontFamily="Consolas" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="0">
                        <TextBlock Text="Session reset kind" Foreground="#BBBBBB" Margin="0,8,0,2" />
                        <ComboBox x:Name="SessionResetKindCombo" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="2">
                        <TextBlock Text="Weekly reset kind" Foreground="#BBBBBB" Margin="0,8,0,2" />
                        <ComboBox x:Name="WeeklyResetKindCombo" />
                    </StackPanel>

                    <StackPanel Grid.Row="3" Grid.Column="0">
                        <TextBlock Text="Identity (optional)" Foreground="#BBBBBB" Margin="0,8,0,2" />
                        <TextBox x:Name="IdentityBox" Padding="4" FontFamily="Consolas" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
