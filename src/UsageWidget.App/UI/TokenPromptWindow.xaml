<Window x:Class="UsageWidget.App.UI.TokenPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Re-paste token" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="#1E1E1E">
    <StackPanel Margin="16">
        <TextBlock x:Name="HeaderText" Foreground="White" FontSize="15" FontWeight="SemiBold"
                   TextWrapping="Wrap" />
        <TextBlock Foreground="#AAAAAA" FontSize="12" Margin="0,4,0,8" TextWrapping="Wrap"
                   Text="Grab a fresh token the same way (F12 → Network → the usage request → Authorization/Cookie) and paste it below." />
        <TextBox x:Name="TokenBox" Height="80" Padding="4" TextWrapping="Wrap"
                 AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" />
        <DockPanel Margin="0,14,0,0" LastChildFill="False">
            <Button Content="Cancel" Width="90" Padding="6,4" DockPanel.Dock="Right" Click="OnCancel" />
            <Button Content="Save" Width="90" Padding="6,4" DockPanel.Dock="Right" Margin="0,0,8,0"
                    Click="OnSave" IsDefault="True" />
        </DockPanel>
    </StackPanel>
</Window>
