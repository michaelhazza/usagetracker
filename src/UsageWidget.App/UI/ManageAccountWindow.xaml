<Window x:Class="UsageWidget.App.UI.ManageAccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manage account" Width="600" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="#1E1E1E">
    <StackPanel Margin="16">
        <TextBlock Text="Manage account" Foreground="White" FontSize="18" FontWeight="SemiBold" />

        <TextBlock Text="Nickname" Foreground="#BBBBBB" Margin="0,12,0,2" />
        <TextBox x:Name="NicknameBox" Padding="4" />

        <Border Background="#262626" CornerRadius="8" Padding="12" Margin="0,14,0,0">
            <TextBlock Foreground="#CFCFCF" FontSize="12" TextWrapping="Wrap">
                <Run Text="Login expired? Refresh it: claude.ai → Settings → Usage → F12 → Network →" />
                <Run Text="right-click the 'usage' request → Copy → Copy as cURL, then paste below." /><LineBreak/>
                <Run Text="Leave this empty to just rename." Foreground="#999999" />
            </TextBlock>
        </Border>

        <TextBlock Text="Paste a new 'Copy as cURL' (optional)" Foreground="#BBBBBB" Margin="0,12,0,2" />
        <TextBox x:Name="CurlBox" Height="100" Padding="4" TextWrapping="Wrap"
                 AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" />

        <TextBlock x:Name="ErrorText" Foreground="#E08A8A" Margin="0,8,0,0"
                   FontWeight="SemiBold" TextWrapping="Wrap" Visibility="Collapsed" />

        <StackPanel x:Name="StatusPanel" Orientation="Horizontal" Margin="0,8,0,0" Visibility="Collapsed">
            <ProgressBar x:Name="Progress" IsIndeterminate="True" Width="140" Height="6"
                         VerticalAlignment="Center" />
            <TextBlock x:Name="StatusText" Foreground="#CFCFCF" Margin="10,0,0,0"
                       VerticalAlignment="Center" />
        </StackPanel>

        <DockPanel Margin="0,16,0,0" LastChildFill="False">
            <Button x:Name="CancelButton" Content="Cancel" Width="90" Padding="6,4"
                    DockPanel.Dock="Right" Click="OnCancel" />
            <Button x:Name="SaveButton" Content="Save" Width="120" Padding="6,4"
                    DockPanel.Dock="Right" Margin="0,0,8,0" Click="OnSave" IsDefault="True" />
        </DockPanel>
    </StackPanel>
</Window>
