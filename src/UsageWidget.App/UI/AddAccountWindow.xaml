<Window x:Class="UsageWidget.App.UI.AddAccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add account" Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="#1E1E1E">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="250" />
        </Grid.ColumnDefinitions>

        <!-- Left: the form -->
        <StackPanel Grid.Column="0">
            <TextBlock Text="Add an account" Foreground="White" FontSize="18" FontWeight="SemiBold" />

            <TextBlock Text="Service" Foreground="#BBBBBB" Margin="0,12,0,2" />
            <ComboBox x:Name="SourceCombo" DisplayMemberPath="Display" SelectedIndex="0" />

            <TextBlock Text="Nickname (optional)" Foreground="#BBBBBB" Margin="0,12,0,2" />
            <TextBox x:Name="NicknameBox" Padding="4" />

            <TextBlock x:Name="TokenLabel" Text="Paste your token here" Foreground="#BBBBBB" Margin="0,12,0,2" />
            <TextBox x:Name="TokenBox" Height="90" Padding="4" TextWrapping="Wrap"
                     AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                     FontFamily="Consolas" />
            <TextBlock x:Name="TokenHint" Foreground="#888888" FontSize="11" Margin="0,4,0,0"
                       TextWrapping="Wrap"
                       Text="Tip: paste the value after 'Bearer ' from the Authorization header, OR the full Cookie value if that's what the request uses." />

            <TextBlock x:Name="ErrorText" Foreground="#E08A8A" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed" />

            <DockPanel Margin="0,16,0,0" LastChildFill="False">
                <Button x:Name="CancelButton" Content="Cancel" Width="90" Padding="6,4"
                        DockPanel.Dock="Right" Click="OnCancel" />
                <Button x:Name="SaveButton" Content="Save account" Width="120" Padding="6,4"
                        DockPanel.Dock="Right" Margin="0,0,8,0" Click="OnSave" IsDefault="True" />
            </DockPanel>
        </StackPanel>

        <!-- Right: the built-in DevTools how-to -->
        <Border Grid.Column="2" Background="#262626" CornerRadius="8" Padding="12">
            <StackPanel>
                <TextBlock Text="How to get your token" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,8" />
                <TextBlock Foreground="#CFCFCF" FontSize="12" TextWrapping="Wrap">
                    <Run Text="1. Open this account in your browser and go to claude.ai → Settings → Usage." /><LineBreak/><LineBreak/>
                    <Run Text="2. Press F12 to open Developer Tools, then click the Network tab." /><LineBreak/><LineBreak/>
                    <Run Text="3. Refresh the Usage page so the network list fills up." /><LineBreak/><LineBreak/>
                    <Run Text="4. Click rows and check the 'Response' tab until you find the one whose JSON shows your usage % and reset times." /><LineBreak/><LineBreak/>
                    <Run Text="5. In that request's 'Headers', find the Authorization header and copy the value after 'Bearer '. If there's no Authorization, copy the whole Cookie value instead." /><LineBreak/><LineBreak/>
                    <Run Text="6. Paste it into the box on the left and click Save." /><LineBreak/><LineBreak/>
                    <Run Text="Note: you also need to tell the app that request's URL once — use 'Endpoint setup' on the main panel. The steps there are the same capture." />
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</Window>
