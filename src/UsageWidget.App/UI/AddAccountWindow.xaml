<Window x:Class="UsageWidget.App.UI.AddAccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add account" Width="600" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="#1E1E1E">
    <StackPanel Margin="16">
        <TextBlock Text="Add an account" Foreground="White" FontSize="18" FontWeight="SemiBold" />

        <!-- The whole how-to, right on the screen -->
        <Border Background="#262626" CornerRadius="8" Padding="12" Margin="0,10,0,0">
            <TextBlock Foreground="#CFCFCF" FontSize="12" TextWrapping="Wrap">
                <Run Text="1. Open this account in your browser → claude.ai → Settings → Usage." /><LineBreak/>
                <Run Text="2. Press F12 → click the Network tab → tick 'Fetch/XHR'." /><LineBreak/>
                <Run Text="3. Click the little refresh circle on the Usage panel." /><LineBreak/>
                <Run Text="4. Right-click the request named 'usage' → Copy → Copy as cURL." /><LineBreak/>
                <Run Text="5. Paste it in the box below and click Save. That's it." />
            </TextBlock>
        </Border>

        <TextBlock Text="Service" Foreground="#BBBBBB" Margin="0,12,0,2" />
        <ComboBox x:Name="SourceCombo" DisplayMemberPath="Display" SelectedIndex="0" />

        <TextBlock Text="Nickname (optional)" Foreground="#BBBBBB" Margin="0,12,0,2" />
        <TextBox x:Name="NicknameBox" Padding="4" />

        <TextBlock Text="Paste the 'Copy as cURL' here" Foreground="#BBBBBB" Margin="0,12,0,2" />
        <TextBox x:Name="CurlBox" Height="120" Padding="4" TextWrapping="Wrap"
                 AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" />

        <TextBlock x:Name="ErrorText" Foreground="#E08A8A" Margin="0,8,0,0"
                   TextWrapping="Wrap" Visibility="Collapsed" />

        <DockPanel Margin="0,16,0,0" LastChildFill="False">
            <Button x:Name="CancelButton" Content="Cancel" Width="90" Padding="6,4"
                    DockPanel.Dock="Right" Click="OnCancel" />
            <Button x:Name="SaveButton" Content="Save account" Width="120" Padding="6,4"
                    DockPanel.Dock="Right" Margin="0,0,8,0" Click="OnSave" IsDefault="True" />
        </DockPanel>
    </StackPanel>
</Window>
