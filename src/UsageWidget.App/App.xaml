<Application x:Class="UsageWidget.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <SolidColorBrush x:Key="OkBrush" Color="#2E9E44" />
        <SolidColorBrush x:Key="WarnBrush" Color="#E08A1E" />
        <SolidColorBrush x:Key="CritBrush" Color="#D13A3A" />
        <SolidColorBrush x:Key="TrackBrush" Color="#2A2A2A" />
        <SolidColorBrush x:Key="PanelBrush" Color="#1E1E1E" />
    </Application.Resources>
</Application>
